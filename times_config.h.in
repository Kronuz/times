/*
 * Generated by CMake from times_config.h.in. This is the standalone library's
 * own feature-detection header: it replaces Xapiand's project-wide "config.h",
 * which times.h used solely for HAVE_CLOCK_GETTIME. CMake probes for
 * clock_gettime with check_symbol_exists() and #cmakedefine's the result here.
 * On macOS, where clock_gettime is present, this is defined and the Mach
 * fallback in times.cc compiles to nothing.
 *
 * Do not edit by hand. Edit times_config.h.in and re-run CMake.
 */

#pragma once

#cmakedefine HAVE_CLOCK_GETTIME 1
